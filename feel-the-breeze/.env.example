# Empty GitHub repo that argocd-autopilot will populate.
GIT_REPO=https://github.com/<your-user>/kcd-2026-gitops.git

# Fine-grained PAT with Contents: Read & write on that repo.
GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Optional) override defaults
# FACTORY_VM_NAME=factory
# FACTORY_CPUS=2
# FACTORY_MEMORY=1.5GiB
# K3D_CLUSTER=hq
# K3D_SERVERS=1
# K3D_AGENTS=1
# K3S_IMAGE=rancher/k3s:v1.31.5-k3s1
